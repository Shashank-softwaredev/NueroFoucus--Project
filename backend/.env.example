# Copy values into your shell or hosting provider. Never commit real secrets.
ENVIRONMENT=development
NEUROFOCUS_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./neurofocus.db
NEUROFOCUS_HR_INVITE_CODE=set-a-private-code-for-deployed-HR-registration

# Optional Metered.ca / Twilio TURN service (recommended for cross-network calls)
NEUROFOCUS_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349?transport=tcp
NEUROFOCUS_TURN_USERNAME=your-turn-username
NEUROFOCUS_TURN_CREDENTIAL=your-turn-credential
